# ════════════════════════════════════════════════════════════════
# .env.example  –  Sao chép thành .env rồi điền giá trị
#   Windows : copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Chỉ cần ĐIỀN ĐÚNG MỘT backend LLM là app chạy được.
# ════════════════════════════════════════════════════════════════

# ── Stage 1 · Model ViT5 (sinh câu hỏi + đáp án) ───────────────
# Chạy local bằng torch/transformers, không cần key.
# Model mặc định đã fine-tune QAG tiếng Việt:
VIQAG_MODEL=shnl/vit5-vinewsqa-qg-ae

# Chỉ cần nếu model là gated/private (https://huggingface.co/settings/tokens)
HF_TOKEN=

# ── Stage 2 · Backend LLM (sinh distractors) ───────────────────
# auto   = tự dò theo key có trong file này (ưu tiên groq → openai → gemini → ollama)
# gemini | openai | groq | ollama = ép dùng backend tương ứng
LLM_BACKEND=auto

# Option 1 – Google Gemini (free tier, khuyến nghị cho demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Có thể thêm key dự phòng để luân phiên khi hết quota:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Option 2 – OpenAI (trả phí, chất lượng cao)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 3 – Groq (free tier, tốc độ rất cao)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 4 – Ollama (local, miễn phí, dữ liệu không rời máy)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
